<Application x:Class="AshtronV7.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AshtronV7"
             xmlns:views="clr-namespace:AshtronV7.Views"
             StartupUri="Views/LoginWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <views:EngineStateToVisibilityConverter x:Key="EngineStateToVisibilityConverter"/>
            <views:ProcessCategoryToColorConverter x:Key="ProcessCategoryToColorConverter"/>
            <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <views:TabVisibilityConverter x:Key="TabVisibilityConverter"/>
            <views:StringEqualityConverter x:Key="StringEqualityConverter"/>
            <views:BytesToMBConverter x:Key="BytesToMBConverter"/>
            <views:BytesToGBConverter x:Key="BytesToGBConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>