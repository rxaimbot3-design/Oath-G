<Window x:Class="AshtronV7.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AshtronV7.Views"
        mc:Ignorable="d"
        Title="ASHTRON V7 — Login"
        Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Window.Resources>
        <ResourceDictionary Source="../Resources/Styles.xaml" />
    </Window.Resources>

    <Border CornerRadius="12" Background="#1A1A2E" BorderBrush="#00C8FF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Height="40" Background="#0F0F1A" CornerRadius="12,12,0,0" BorderBrush="#00C8FF" BorderThickness="0,0,0,1">
                <Grid>
                    <TextBlock Text="ASHTRON V7" FontSize="14" FontWeight="Bold" Foreground="#00C8FF" 
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Text="ULTRA FRAME ENGINE" FontSize="10" Foreground="#666" 
                               VerticalAlignment="Center" Margin="120,0,0,0"/>
                    <Button Content="✕" Width="32" Height="32" HorizontalAlignment="Right" Margin="0,4,8,4"
                            Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <!-- Login Form -->
            <Border Grid.Row="1" Margin="32,24,32,16">
                <StackPanel>
                    <TextBlock Text="SIGN IN" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" 
                               HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Competitive Performance Engine" FontSize="12" Foreground="#888" 
                               HorizontalAlignment="Center" Margin="0,0,0,32"/>

                    <TextBlock Text="USERNAME" FontSize="11" FontWeight="SemiBold" Foreground="#00C8FF" Margin="0,0,0,4"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource InputTextBoxStyle}" FontSize="14" Padding="12,8"
                                 Background="Transparent" BorderThickness="0" Foreground="#FFF" CaretBrush="#00C8FF"/>
                    </Border>

                    <TextBlock Text="PASSWORD" FontSize="11" FontWeight="SemiBold" Foreground="#00C8FF" Margin="0,16,0,4"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBoxStyle}" 
                                     FontSize="14" Padding="12,8" Background="Transparent" BorderThickness="0" 
                                     Foreground="#FFF" CaretBrush="#00C8FF" PasswordChanged="PasswordBox_PasswordChanged"/>
                    </Border>

                    <TextBlock x:Name="ErrorText" Text="{Binding ErrorMessage}" FontSize="11" Foreground="#FF6B6B" 
                               Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Button Content="LOGIN" Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding LoginCommand}" IsDefault="True"
                            Height="44" Margin="0,24,0,0" FontSize="14" FontWeight="Bold">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding}"/>
                                    <TextBlock x:Name="LoadingSpinner" Text=" ⏳" Visibility="Collapsed"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLoggingIn}" Value="True">
                                        <Setter TargetName="LoadingSpinner" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <TextBlock Text="Default: ashtron / 1" FontSize="10" Foreground="#555" 
                               HorizontalAlignment="Center" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="2" Height="40" Background="#0F0F1A" CornerRadius="0,0,12,12" BorderBrush="#00C8FF" BorderThickness="0,1,0,0">
                <TextBlock Text="ASHTRON TECHNOLOGIES — RYZEN 5 5600X / GTX 1660 OPTIMIZED" 
                           FontSize="9" Foreground="#444" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>