<Window x:Class="AshtronV7.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AshtronV7.Views"
        xmlns:vm="clr-namespace:AshtronV7.ViewModels"
        xmlns:models="clr-namespace:AshtronV7.Models"
        mc:Ignorable="d"
        Title="ASHTRON V7 — ULTRA FRAME ENGINE"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <local:BytesToMBConverter x:Key="BytesToMBConverter"/>
            <local:BytesToGBConverter x:Key="BytesToGBConverter"/>
            <local:ProcessCategoryToColorConverter x:Key="ProcessCategoryToColorConverter"/>
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:EngineStateToVisibilityConverter x:Key="EngineStateToVisibilityConverter"/>
            <local:ProcessCategoryToColorConverter x:Key="ProcessCategoryToColorConverter"/>
            <local:TabVisibilityConverter x:Key="TabVisibilityConverter"/>
            <local:StringEqualityConverter x:Key="StringEqualityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Border Grid.Row="0" Style="{StaticResource TitleBarStyle}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Ellipse Width="28" Height="28" Fill="{StaticResource AccentPrimaryBrush}" Margin="0,0,10,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00C8FF" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                        </Ellipse.Effect>
                    </Ellipse>
                    <StackPanel>
                        <TextBlock Text="ASHTRON V7" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="ULTRA FRAME ENGINE" FontSize="9" Foreground="{StaticResource AccentPrimaryBrush}" 
                                   FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tab Navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Content="HOME" Style="{StaticResource TabButtonStyle}" 
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Home}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Home"/>
                    <RadioButton Content="ENGINE" Style="{StaticResource TabButtonStyle}" 
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Engine}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Engine"/>
                    <RadioButton Content="FOCUS" Style="{StaticResource TabButtonStyle}" 
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Focus}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Focus"/>
                    <RadioButton Content="BACKGROUND" Style="{StaticResource TabButtonStyle}" 
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Background}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Background"/>
                    <RadioButton Content="LOGS" Style="{StaticResource TabButtonStyle}" 
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource StringEqualityConverter}, ConverterParameter=Logs}"
                                 Command="{Binding SwitchTabCommand}" CommandParameter="Logs"/>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button Style="{StaticResource MinimizeButtonStyle}" Width="36" Height="32" 
                            Click="MinimizeButton_Click" ToolTip="Minimize to Tray">
                        <TextBlock Text="⎯" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource CloseButtonStyle}" Width="36" Height="32" 
                            Click="CloseButton_Click" ToolTip="Close">
                        <TextBlock Text="✕" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <!-- HOME TAB -->
            <ScrollViewer x:Name="HomeTab" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Home}" 
                          Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24">
                    <!-- Engine Status Banner -->
                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,16" 
                            BorderBrush="{Binding EngineStatusColor}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Ellipse Width="16" Height="16" Fill="{Binding EngineStatusColor}" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="{Binding EngineStatusColor}" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            
                            <TextBlock Grid.Column="1" Text="{Binding EngineStatusText}" FontSize="20" FontWeight="Bold" 
                                       Foreground="{Binding EngineStatusColor}" VerticalAlignment="Center"/>
                            
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="START COMPETITIVE ENGINE" Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding StartEngineCommand}" Padding="28,14" FontSize="13"
                                        Visibility="{Binding EngineState, Converter={StaticResource EngineStateToVisibilityConverter}, ConverterParameter=Stopped}"/>
                                <Button Content="STOP ENGINE" Style="{StaticResource DangerButtonStyle}" 
                                        Command="{Binding StopEngineCommand}" Padding="28,14" FontSize="13" Margin="12,0,0,0"
                                        Visibility="{Binding EngineState, Converter={StaticResource EngineStateToVisibilityConverter}, ConverterParameter=Active}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Metrics Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Current FPS -->
                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="CURRENT FPS" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentMetrics.CurrentFps, StringFormat='{}{0:F1}'}" 
                                           FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" 
                                           FontFamily="Consolas"/>
                                <TextBlock Text="frames/sec" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Average FPS -->
                        <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="4,0,4,8">
                            <StackPanel>
                                <TextBlock Text="AVERAGE FPS" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentMetrics.AverageFps, StringFormat='{}{0:F1}'}" 
                                           FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" 
                                           FontFamily="Consolas"/>
                                <TextBlock Text="session avg" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- 1% Low FPS -->
                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="4,0,4,8">
                            <StackPanel>
                                <TextBlock Text="1% LOW FPS" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentMetrics.OnePercentLowFps, StringFormat='{}{0:F1}'}" 
                                           FontSize="36" FontWeight="Bold" Foreground="{StaticResource AccentWarningBrush}" 
                                           FontFamily="Consolas"/>
                                <TextBlock Text="stability metric" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Frame Time -->
                        <Border Grid.Column="3" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,8">
                            <StackPanel>
                                <TextBlock Text="FRAME TIME" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentMetrics.FrameTimeMs, StringFormat='{}{0:F1} ms'}" 
                                           FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" 
                                           FontFamily="Consolas"/>
                                <TextBlock Text="lower = better" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- System Resources -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU -->
                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CurrentMetrics.CpuUsage, StringFormat='{}{0:F1}%'}" 
                                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentPrimaryBrush}" 
                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar Value="{Binding CurrentMetrics.CpuUsage}" Maximum="100" Style="{StaticResource MetricProgressBar}" Margin="0,8,0,0"/>
                                <TextBlock Text="Ryzen 5 5600X • 6C/12T" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU -->
                        <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="4,0,4,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="GPU" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CurrentMetrics.GpuUsage, StringFormat='{}{0:F1}%'}" 
                                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" 
                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar Value="{Binding CurrentMetrics.GpuUsage}" Maximum="100" Style="{StaticResource MetricProgressBar}" Margin="0,8,0,0"/>
                                <TextBlock Text="GTX 1660 • 6GB GDDR5" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM -->
                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RAM" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CurrentMetrics.RamUsage, StringFormat='{}{0:F1}%'}" 
                                               FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentWarningBrush}" 
                                               FontFamily="Consolas" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar Value="{Binding CurrentMetrics.RamUsage}" Maximum="100" Style="{StaticResource MetricProgressBar}" Margin="0,8,0,0"/>
                                <TextBlock Text="DDR4 • 16GB+ Target" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Emulator & Discord Status -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MSI APP PLAYER" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Fill="#FF5050" VerticalAlignment="Center" Margin="0,0,8,0" x:Name="MsiStatusDot"/>
                                    <TextBlock Text="NOT DETECTED" FontSize="14" FontWeight="Bold" Foreground="#FF5050" 
                                               FontFamily="Consolas" x:Name="MsiStatusText" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Waiting for HD-Player.exe..." FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="DISCORD" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                           FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="10" Height="10" Fill="#FF5050" VerticalAlignment="Center" Margin="0,0,8,0" x:Name="DiscordStatusDot"/>
                                    <TextBlock Text="NOT RUNNING" FontSize="14" FontWeight="Bold" Foreground="#FF5050" 
                                               FontFamily="Consolas" x:Name="DiscordStatusText" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Voice chat preserved" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Active Profile -->
                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ACTIVE PROFILE" FontSize="10" Foreground="{StaticResource TextMutedBrush}" 
                                       FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="{Binding CurrentProfile.Name}" FontSize="16" FontWeight="Bold" 
                                           Foreground="{StaticResource AccentPrimaryBrush}"/>
                                <TextBlock Text="  •  " FontSize="14" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentProfile.Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CurrentProfile.FocusLevel, StringFormat='Focus Level: {0}'}" 
                                       FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ENGINE TAB -->
            <ScrollViewer x:Name="EngineTab" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Engine}" 
                          Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24">
                    <TextBlock Text="ENGINE PROFILES" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <ItemsControl ItemsSource="{Binding AvailableProfiles}">
                        <ItemsControl.Resources>
                            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
                        </ItemsControl.Resources>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,0,12" Padding="20">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Profile}" FontSize="11" Foreground="{StaticResource AccentPrimaryBrush}" 
                                                           FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" Margin="12,0,0,0"
                                                           Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Text="Priority: " FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding EmulatorPriority}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas"/>
                                                <TextBlock Text="  |  Focus: " FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="12,0,0,0"/>
                                                <TextBlock Text="{Binding FocusLevel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" FontFamily="Consolas"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="APPLY" Style="{StaticResource SecondaryButtonStyle}" 
                                                Command="{Binding DataContext.SwitchProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Profile}" Padding="16,6" FontSize="11"
                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="ENGINE CONTROLS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="START COMPETITIVE ENGINE" Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding StartEngineCommand}" Padding="24,12" FontSize="13"
                                        Visibility="{Binding EngineState, Converter={StaticResource EngineStateToVisibilityConverter}, ConverterParameter=Stopped}"/>
                                <Button Content="STOP ENGINE" Style="{StaticResource DangerButtonStyle}" 
                                        Command="{Binding StopEngineCommand}" Padding="24,12" FontSize="13" Margin="12,0,0,0"
                                        Visibility="{Binding EngineState, Converter={StaticResource EngineStateToVisibilityConverter}, ConverterParameter=Active}"/>
                                <Button Content="RESTORE WINDOWS" Style="{StaticResource SecondaryButtonStyle}" 
                                        Command="{Binding RestoreWindowsCommand}" Padding="20,12" FontSize="12" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- FOCUS TAB -->
            <ScrollViewer x:Name="FocusTab" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Focus}" 
                          Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24">
                    <TextBlock Text="PROCESS PRIORITY FOCUS" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="Processes receiving performance priority. HD-Player.exe = Highest, Discord.exe = Secondary" 
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                    <ListView ItemsSource="{Binding FocusedProcesses}" Style="{StaticResource ProcessListViewStyle}" 
                              BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Height="300">
                        <ListView.Resources>
                            <local:BytesToMBConverter x:Key="BytesToMBConverter"/>
                            <local:ProcessCategoryToColorConverter x:Key="ProcessCategoryToColorConverter"/>
                        </ListView.Resources>
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource ProcessGridViewColumnHeader}">
                                <GridViewColumn Header="PROCESS" Width="160" DisplayMemberBinding="{Binding ProcessName}"/>
                                <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding ProcessId}"/>
                                <GridViewColumn Header="PRIORITY" Width="120" DisplayMemberBinding="{Binding Priority}"/>
                                <GridViewColumn Header="AFFINITY" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProcessorAffinity, StringFormat='0x{0:X}'}" 
                                                       FontFamily="Consolas" FontSize="11"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CPU %" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CpuUsage, StringFormat='{0:F1}%'}" 
                                                       FontFamily="Consolas" FontSize="11"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="RAM" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding WorkingSetBytes, StringFormat='{0:F1} MB', Converter={StaticResource BytesToMBConverter}}" 
                                                       FontFamily="Consolas" FontSize="11"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="CATEGORY" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" 
                                                       Foreground="{Binding Category, Converter={StaticResource ProcessCategoryToColorConverter}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <!-- BACKGROUND TAB -->
            <ScrollViewer x:Name="BackgroundTab" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Background}" 
                          Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="SYSTEM PROCESSES" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentMetrics.ProcessCount}" FontSize="32" FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Consolas"/>
                                <TextBlock Text="Total running" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="USER BACKGROUND" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentMetrics.UserBackgroundProcesses}" FontSize="32" FontWeight="Bold" 
                                           Foreground="{StaticResource AccentWarningBrush}" FontFamily="Consolas"/>
                                <TextBlock Text="Target: 60-70" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="RAM USAGE" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentMetrics.RamUsedBytes, Converter={StaticResource BytesToGBConverter}, StringFormat='{0:F1} GB'}" 
                                           FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentSecondaryBrush}" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding CurrentMetrics.RamUsage, StringFormat='{0:F1}% used'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SMART BACKGROUND FOCUS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <ComboBox Grid.Column="1" Width="160" Height="32" 
                                          SelectedItem="{Binding Settings.DefaultFocusLevel}"
                                          ItemsSource="{Binding FocusLevels}"
                                          Style="{StaticResource DarkComboBoxStyle}"/>
                            </Grid>
                            <TextBlock Text="Select focus level to control background process management" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="Minimal: Close top 3  •  Competitive: Close top 8  •  Maximum: Close top 15" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                            <TextBlock Text="Never terminates Windows-critical processes. Uses graceful close first." FontSize="10" Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource MetricCardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="MANAGED BACKGROUND APPLICATIONS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding KnownBackgroundApps}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource BackgroundDarkerBrush}" CornerRadius="4" Margin="0,4,0,0" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding ProcessName}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- LOGS TAB -->
            <ScrollViewer x:Name="LogsTab" Visibility="{Binding SelectedTab, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Logs}" 
                          Style="{StaticResource DarkScrollViewer}" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24,16,24,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ACTIVITY LOG" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Button Grid.Column="1" Content="CLEAR" Style="{StaticResource SecondaryButtonStyle}" Padding="16,6" FontSize="11"
                                Click="ClearLog_Click"/>
                    </Grid>

                    <ListView ItemsSource="{Binding ActivityLog}" Style="{StaticResource ProcessListViewStyle}" 
                              BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Height="600"
                              FontFamily="Consolas" FontSize="11">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Height="32" Background="{StaticResource BackgroundDarkerBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrentMetrics.ProcessCount, StringFormat='Processes: {0}'}" 
                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                <TextBlock Grid.Column="1" Text="ASHTRON V7 — COMPETITIVE PERFORMANCE ENGINE" 
                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="{Binding HardwareInfo.CpuModel}" 
                           FontSize="10" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>