<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Resources\ashtron.ico</ApplicationIcon>
    <AssemblyName>ASHTRON_V7</AssemblyName>
    <RootNamespace>AshtronV7</RootNamespace>
    <AssemblyTitle>ASHTRON V7 — ULTRA FRAME ENGINE</AssemblyTitle>
    <AssemblyDescription>Competitive Performance Engine for Ryzen 5 5600X / GTX 1660 / Free Fire</AssemblyDescription>
    <AssemblyCompany>Ashtron Technologies</AssemblyCompany>
    <AssemblyProduct>ASHTRON V7</AssemblyProduct>
    <AssemblyCopyright>Copyright © 2026 Ashtron Technologies</AssemblyCopyright>
    <AssemblyVersion>7.0.0.0</AssemblyVersion>
    <FileVersion>7.0.0.0</FileVersion>
    <Version>7.0.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\ashtron.ico" />
  </ItemGroup>

</Project>